# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

require "shellwords"

default_platform(:ios)

platform :ios do
  desc "Archive and sign the App Store ipa"
  lane :build do
    # Signing identity comes from the keychain the release workflow imports into,
    # provisioning profiles from App Store Connect during the build. Runbook is
    # docs/apple-signing.md in the ansible repo.
    #
    # No setup_ci: its keychain competes with the one already imported into.

    # No code_sign_identity: naming one alongside automatic signing is a conflict
    # Xcode refuses to build. It selects the identity for the action itself.
    update_code_signing_settings(
      path: "Runner.xcodeproj",
      use_automatic_signing: true,
      team_id: "576H3XS7FP",
      build_configurations: ["Release"],
    )

    increment_build_number(
        xcodeproj: "Runner.xcodeproj",
        build_number: ENV['BUILD_NUMBER']
    )

    increment_version_number(
        xcodeproj: "Runner.xcodeproj",
        version_number: ENV['BUILD_NAME']
    )

    # Archive only. gym passes these to exportArchive itself, and xcodebuild
    # rejects -authenticationKeyPath appearing twice in one invocation.
    # fetch rather than [] so a missing one fails here, not inside xcodebuild.
    build_app(
      output_name: "MobileNebula.ipa",
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      xcargs: [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath #{ENV.fetch('APP_STORE_CONNECT_API_KEY_KEY_FILEPATH').shellescape}",
        "-authenticationKeyID #{ENV.fetch('APP_STORE_CONNECT_API_KEY_KEY_ID').shellescape}",
        "-authenticationKeyIssuerID #{ENV.fetch('APP_STORE_CONNECT_API_KEY_ISSUER_ID').shellescape}",
      ].join(" "),
    )
  end

  desc "Push a new beta build to TestFlight"
  lane :release do
    # Reads APP_STORE_CONNECT_API_KEY_KEY_ID, _ISSUER_ID and _KEY_FILEPATH, which
    # the workflow writes out of apple-signing/asc-api-key.
    app_store_connect_api_key

    upload_to_testflight(skip_waiting_for_build_processing: true)
  end
end
