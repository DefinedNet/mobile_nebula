# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

APP_BUNDLE = "net.defined.mobileNebula"
EXT_BUNDLE = "net.defined.mobileNebula.NebulaNetworkExtension"

default_platform(:ios)

platform :ios do
  desc "Archive and sign the App Store ipa"
  lane :build do
    # Manual signing: automatic wants a cloud managed profile, which Apple refuses
    # here. Runbook is docs/apple-signing.md in the ansible repo.
    #
    # No setup_ci: its keychain competes with the one already imported into.
    app_profile = "apple-signing #{APP_BUNDLE}"
    ext_profile = "apple-signing #{EXT_BUNDLE}"

    [["Runner", app_profile], ["NebulaNetworkExtension", ext_profile]].each do |target, profile|
      update_code_signing_settings(
        path: "Runner.xcodeproj",
        use_automatic_signing: false,
        team_id: "576H3XS7FP",
        code_sign_identity: "Apple Distribution",
        build_configurations: ["Release"],
        targets: [target],
        profile_name: profile
      )
    end

    increment_build_number(
        xcodeproj: "Runner.xcodeproj",
        build_number: ENV['BUILD_NUMBER']
    )

    increment_version_number(
        xcodeproj: "Runner.xcodeproj",
        version_number: ENV['BUILD_NAME']
    )

    # No -allowProvisioningUpdates: it is what sends the export to cloud signing.
    build_app(
      output_name: "MobileNebula.ipa",
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          APP_BUNDLE => app_profile,
          EXT_BUNDLE => ext_profile,
        },
      },
    )
  end

  desc "Push a new beta build to TestFlight"
  lane :release do
    # Reads APP_STORE_CONNECT_API_KEY_KEY_ID, _ISSUER_ID and _KEY_FILEPATH, which
    # the workflow writes out of apple-signing/asc-api-key.
    app_store_connect_api_key

    upload_to_testflight(skip_waiting_for_build_processing: true)
  end
end
