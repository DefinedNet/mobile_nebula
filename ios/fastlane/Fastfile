# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do
  desc "Archive and sign the App Store ipa"
  lane :build do
    # The signing identity comes from apple-signing/distribution in Secrets Manager,
    # imported into a keychain by the release workflow. Provisioning profiles are
    # fetched from App Store Connect during the build, so there is no longer a match
    # repository holding a second copy of the certificate and the profiles. The
    # runbook is docs/apple-signing.md in the ansible repo.
    #
    # No setup_ci: it exists to give match a keychain to install into, and its
    # keychain would only compete with the one the workflow imported into.

    # Both targets inherit CODE_SIGN_IDENTITY[sdk=iphoneos*] = "iPhone Developer"
    # from the project's Release configuration, which is wrong for an App Store
    # build, so it still has to be overridden. What changed is the signing style:
    # automatic is what lets Xcode resolve the profiles itself.
    update_code_signing_settings(
      path: "Runner.xcodeproj",
      use_automatic_signing: true,
      team_id: "576H3XS7FP",
      code_sign_identity: "Apple Distribution",
      build_configurations: ["Release"],
    )

    increment_build_number(
        xcodeproj: "Runner.xcodeproj",
        build_number: ENV['BUILD_NUMBER']
    )

    increment_version_number(
        xcodeproj: "Runner.xcodeproj",
        version_number: ENV['BUILD_NAME']
    )

    # Archiving and exporting each resolve provisioning, so both need the key.
    # fetch rather than [] so a missing one fails here, not inside xcodebuild.
    asc = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath #{ENV.fetch('APP_STORE_CONNECT_API_KEY_KEY_FILEPATH')}",
      "-authenticationKeyID #{ENV.fetch('APP_STORE_CONNECT_API_KEY_KEY_ID')}",
      "-authenticationKeyIssuerID #{ENV.fetch('APP_STORE_CONNECT_API_KEY_ISSUER_ID')}",
    ].join(" ")

    build_app(
      output_name: "MobileNebula.ipa",
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      xcargs: asc,
      export_xcargs: asc,
    )
  end

  desc "Push a new beta build to TestFlight"
  lane :release do
    # Reads APP_STORE_CONNECT_API_KEY_KEY_ID, _ISSUER_ID and _KEY_FILEPATH, which
    # the workflow writes out of apple-signing/asc-api-key. Uploading signs nothing,
    # so there is no keychain to set up.
    app_store_connect_api_key

    upload_to_testflight(skip_waiting_for_build_processing: true)
  end
end
