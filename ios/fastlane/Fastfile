# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

require "shellwords"

default_platform(:ios)

platform :ios do
  desc "Archive and sign the App Store ipa"
  lane :build do
    # Signing identity comes from the keychain the release workflow imports into,
    # profiles from the PROFILE_* variables it sets. Runbook is
    # docs/apple-signing.md in the ansible repo.
    #
    # Manual signing, not automatic: automatic will not use a profile we created,
    # it wants a cloud managed one and Apple refuses that here.
    #
    # No setup_ci: its keychain competes with the one already imported into.
    app_profile = ENV.fetch("PROFILE_APP_NAME")
    ext_profile = ENV.fetch("PROFILE_EXT_NAME")

    update_code_signing_settings(
      path: "Runner.xcodeproj",
      use_automatic_signing: false,
      team_id: "576H3XS7FP",
      code_sign_identity: "Apple Distribution",
      build_configurations: ["Release"],
    )

    update_project_provisioning(
      xcodeproj: "Runner.xcodeproj",
      target_filter: "Runner",
      profile: ENV.fetch("PROFILE_APP_PATH"),
      build_configuration: "Release"
    )

    update_project_provisioning(
      xcodeproj: "Runner.xcodeproj",
      target_filter: "NebulaNetworkExtension",
      profile: ENV.fetch("PROFILE_EXT_PATH"),
      build_configuration: "Release"
    )

    increment_build_number(
        xcodeproj: "Runner.xcodeproj",
        build_number: ENV['BUILD_NUMBER']
    )

    increment_version_number(
        xcodeproj: "Runner.xcodeproj",
        version_number: ENV['BUILD_NAME']
    )

    # No -allowProvisioningUpdates: it is what sends the export to cloud signing.
    # The export needs the mapping named, gym does not infer it.
    build_app(
      output_name: "MobileNebula.ipa",
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "net.defined.mobileNebula" => app_profile,
          "net.defined.mobileNebula.NebulaNetworkExtension" => ext_profile,
        },
      },
    )
  end

  desc "Push a new beta build to TestFlight"
  lane :release do
    # Reads APP_STORE_CONNECT_API_KEY_KEY_ID, _ISSUER_ID and _KEY_FILEPATH, which
    # the workflow writes out of apple-signing/asc-api-key.
    app_store_connect_api_key

    upload_to_testflight(skip_waiting_for_build_processing: true)
  end
end
